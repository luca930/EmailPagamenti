{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Transactions": "Data Source=dati/pagamenti.db"
  },
  "Security": {
    "AllowAnonymous": false,
    "RequireHttps": false,
    "SessionLifetime": "7.00:00:00"
  },
  "Imap": {
    "Host": "imap.gmail.com",
    "Port": 993,
    "UserName": "",
    "Folders": [ "INBOX" ],
    "UseSsl": true,
    "MaxMessagesPerRun": 500
  },
  "Ingestion": {
    "Enabled": true,
    "InitialLookback": "365.00:00:00",
    "Overlap": "06:00:00",
    "PollInterval": "00:15:00",
    "BatchSize": 100,
    "MinConfidence": 0.6,
    "ReviewThreshold": 0.3,
    "StoreIgnored": false,
    "BodySnippetLength": 500
  },
  "Banks": {
    "UseBuiltInProfiles": true,
    "Profiles": []
  },
  "Categories": {
    "UseBuiltInRules": true,
    "Rules": {}
  }
}
