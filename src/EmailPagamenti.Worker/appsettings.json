{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Payments": "Data Source=pagamenti.db"
  },
  "Imap": {
    "Host": "imap.gmail.com",
    "Port": 993,
    "UserName": "",
    "Folders": [ "INBOX" ],
    "UseSsl": true,
    "MaxMessagesPerRun": 500
  },
  "Ingestion": {
    "InitialLookback": "90.00:00:00",
    "Overlap": "06:00:00",
    "PollInterval": "00:15:00",
    "BatchSize": 100,
    "MinConfidence": 0.6,
    "ReviewThreshold": 0.3,
    "StoreIgnored": false,
    "BodySnippetLength": 500
  },
  "Classification": {
    "TrustedSenders": [],
    "Merchants": [
      {
        "Name": "Amazon",
        "SenderContains": "amazon.",
        "Kind": "Receipt",
        "Direction": "Outgoing"
      },
      {
        "Name": "PayPal",
        "SenderContains": "paypal.",
        "Kind": "Receipt",
        "Direction": "Outgoing"
      }
    ]
  }
}
