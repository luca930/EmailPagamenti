# Copiare in .env e riempire. Il file .env non va nel repository: e' gia' escluso.
#
# Prima di questo file, avviare il Postgres condiviso una volta sola:
# vedi infra/postgres/README.md. La base dati e l'utente "emailpagamenti" che
# DB_UTENTE/DB_PASSWORD qui sotto identificano si creano li', non qui.

# Password per entrare nell'interfaccia. Lunga, e diversa da quelle che usi altrove.
SPESE_PASSWORD=

# Casella dove arrivano le notifiche della banca.
# Su Gmail serve una password per app, non quella dell'account.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_UTENTE=
IMAP_PASSWORD=

# Utente e password della base dati "emailpagamenti" sul Postgres condiviso
# (creati seguendo infra/postgres/README.md).
DB_UTENTE=emailpagamenti
DB_PASSWORD=

# Ogni quanto rileggere la casella, e quanto storico recuperare alla prima esecuzione.
INTERVALLO=00:15:00
STORICO_INIZIALE=365.00:00:00

# Da accendere quando l'applicazione sta dietro un reverse proxy con certificato.
SPESE_RICHIEDI_HTTPS=false

# Per provare la dashboard con dati d'esempio invece che con la posta vera:
# ACQUISIZIONE_ATTIVA=false
# DEMO_SEED=true
# (IMAP_HOST/IMAP_UTENTE/IMAP_PASSWORD restano obbligatori ma possono essere finti,
# perche' con l'acquisizione spenta non vengono mai usati. Vedi il README.)
