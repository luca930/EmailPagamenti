# Copiare in .env e riempire. Il file .env non va nel repository: e' gia' escluso.

# Password per entrare nell'interfaccia. Lunga, e diversa da quelle che usi altrove.
SPESE_PASSWORD=

# Casella dove arrivano le notifiche della banca.
# Su Gmail serve una password per app, non quella dell'account.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_UTENTE=
IMAP_PASSWORD=

# Ogni quanto rileggere la casella, e quanto storico recuperare alla prima esecuzione.
INTERVALLO=00:15:00
STORICO_INIZIALE=365.00:00:00

# Da accendere quando l'applicazione sta dietro un reverse proxy con certificato.
SPESE_RICHIEDI_HTTPS=false
